# Copy into ~/.grok/config.toml. `beast install --write-config` adds only the [skills]
# and [system-prompt-overrides] keys below, and only when they are absent.

[models]
default = "grok-4.5"
default_reasoning_effort = "high"

[ui]
compact_mode = false
permission_mode = "ask"          # the source used "always-approve"; opt into that yourself

# Grok discovers skills from ~/.agents/skills, which beast populates.
# `ignore` keeps it from double-loading the same skills via the Claude mirror.
[skills]
paths = ["~/.agents/skills"]
ignore = ["~/.claude/skills"]

# Grok has no --system-prompt-file equivalent, so it reads the prompt from a path.
# ~/.grok/BEAST.v2.md is the same real file the Codex prompt links to, under Grok's own
# namespace — a grok-only install therefore has it. Point this at BEAST.v2.md, not the
# older BEAST.md: the original config aimed at the stale file while the alias used this one.
[system-prompt-overrides]
paths = ["~/.grok/BEAST.v2.md"]

# The source config also listed [agents] paths at ~/.agents/agents and ~/.codex/agents.
# Neither directory exists, so it is omitted here rather than shipped broken.
