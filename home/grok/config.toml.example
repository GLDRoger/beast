# Copy into ~/.grok/config.toml. `beast install --write-config` adds only the [skills]
# keys below, and only when they are absent.

[models]
default = "grok-4.6"
default_reasoning_effort = "high"

[ui]
compact_mode = false
permission_mode = "ask"          # the source used "always-approve"; opt into that yourself

# Grok discovers skills from ~/.agents/skills, which beast populates.
# `ignore` keeps it from double-loading the same skills via the Claude mirror.
[skills]
paths = ["~/.agents/skills"]
ignore = ["~/.claude/skills"]

# Grok has no prompt-file flag or config key. Beast reaches every launch (TUI,
# T3 Code's `grok agent stdio`, agent-broker turns) as the ~/.grok/AGENT.md rules
# file, appended to Grok's native prompt. Rules files truncate at 10,000 characters.

# The agent-broker MCP surface, same registration codex carries. The command is
# the pnpm-linked broker binary; adjust the path if pnpm's bin dir differs.
[mcp_servers.agent-broker]
command = "~/Library/pnpm/broker"
args = ["mcp"]
enabled = true

# The source config also listed [agents] paths at ~/.agents/agents and ~/.codex/agents.
# Neither directory exists, so it is omitted here rather than shipped broken.
